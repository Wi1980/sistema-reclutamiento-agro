# ============================================
# AGROEXPORTADORA - Backend Environment Variables
# Copiar a .env y configurar valores reales
# ============================================

NODE_ENV=development
PORT=4000

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=agroexportadora_user
DB_PASSWORD=<cambia_esta_clave>
DB_NAME=agroexportadora_db
DB_CONNECTION_LIMIT=10

# JWT Secrets (generar con: openssl rand -base64 64)
JWT_ACCESS_SECRET=cambia_este_secret_muy_largo_y_seguro_acceso
JWT_REFRESH_SECRET=cambia_este_secret_muy_largo_y_seguro_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS - URL del frontend
CORS_ORIGIN=http://localhost:5173

# Bcrypt rounds (12 en producción)
BCRYPT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Logs
LOG_LEVEL=info

# Contraseña inicial del usuario admin@agroexportadora.com (solo para npm run seed)
SEED_ADMIN_PASSWORD=<define_una_clave_segura>
